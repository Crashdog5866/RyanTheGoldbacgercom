# Content Engine Configuration - "Tickle The Algorithm"
# For Ryan Goldbacher - Tour Management, Production, FOH Audio Engineering

brand:
  name: "Ryan Goldbacher"
  tagline: "Tour Manager · Production Manager · FOH Audio Engineer"
  location: "Nashville, TN"
  url: "https://ryangoldbacher.com"

social:
  instagram: "https://www.instagram.com/ryanthegoldbacher/"
  tiktok: "https://www.tiktok.com/@RyanTheGoldbacher"
  youtube: "https://www.youtube.com/@RyanTheGoldbacher"
  linktree: "https://linktr.ee/RyanTheGoldbacher"

contentStrategy:
  primaryPillars:
    - "Tour Management"
    - "Production Management"
    - "FOH Audio Engineering"
    - "Live Tour Logistics"
  
  weeklyTopics:
    - "Tour management best practices"
    - "Production management checklists"
    - "FOH mixing techniques"
    - "Live event case studies"
    - "Industry news and trends"
  
  postFrequency: "weekly"
  wordCount: "500-800"
  
  targetKeywords:
    primary: ["tour manager", "production manager", "FOH engineer", "live sound", "tour logistics"]
    secondary: ["concert production", "tour schedule", "sound engineering", "live events", "touring"]

socialCalendar:
  week1:
    - platform: "Instagram"
      type: "behind-the-scenes"
      content: "Soundcheck setup at venue"
    - platform: "TikTok"
      type: "explainer"
      content: "What a tour manager actually does (30s)"
    - platform: "YouTube"
      type: "short-form"
      content: "Intro to tour management"
    - platform: "LinkedIn"
      type: "article"
      content: "Tour Management Principles"

  week2:
    - platform: "Instagram"
      type: "carousel"
      content: "3 principles of production management"
    - platform: "TikTok"
      type: "day-in-the-life"
      content: "Day in the life: Tour manager"
    - platform: "YouTube"
      type: "explanation"
      content: "How FOH mixing works"
    - platform: "Linktree"
      type: "link"
      content: "New blog post link"

  week3:
    - platform: "Instagram"
      type: "schedule"
      content: "Tour dates for Accept"
    - platform: "TikTok"
      type: "humorous"
      content: "Tour life reality check"
    - platform: "YouTube"
      type: "podcast-clip"
      content: "Podcast episode preview"
    - platform: "Blog"
      type: "pillar-article"
      content: "How to Manage International Tours"

  week4:
    - platform: "Instagram"
      type: "Q&A"
      content: "Ask me anything - tour management"
    - platform: "TikTok"
      type: "quick-tips"
      content: "Tour manager tips you didn't know"
    - platform: "YouTube"
      type: "full-episode"
      content: "Full podcast discussion"
    - platform: "All"
      type: "auto-adapted"
      content: "Blog content posted to all channels"

tracking:
  analytics: "Google Analytics 4 (G-XXXXXXXXXX)"
  searchConsole: "https://search.google.com/search-console"
  bingWebmaster: "https://www.bing.com/webmasters"
  weeklyAudit: "skills/xiaoyaoclaw-seo-skill/scripts/seo-audit.js"

automation:
  composio:
    enabled: true
    skills: ["composio"]
    platforms: ["instagram", "tiktok", "youtube"]
    autoPost: true
    pullMetrics: true
