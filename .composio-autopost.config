# Composio Instagram Auto-Post Configuration
# For Ryan Goldbacher - Tour Management, Production, FOH Audio Engineering

composio:
  enabled: true
  skill: "composio"
  integration: "instagram"
  status: "ACTIVE"  # Needs OAuth completion

autoPost:
  enabled: true
  platforms:
    - instagram
    - instagram_reels
  schedule: "daily"  # or specific times
  timezone: "America/Chicago"

contentSources:
  blogPosts:
    enabled: true
    autoGenerateImage: true
    template: "blog-announcement"
  tourDates:
    enabled: true
    autoGenerateImage: true
    template: "tour-announcement"
  podcastEpisodes:
    enabled: true
    autoGenerateImage: true
    template: "podcast-promo"
  customPosts:
    enabled: true

templates:
  blog-announcement:
    imagePrompt: "Professional photo of Ryan Goldbacher at FOH console, warm stage lighting, tour management aesthetic"
    captionTemplate: "New blog post: {title}\n\n{excerpt}\n\nRead the full article: {url}\n\n#TourManagement #LiveEvents #RyanGoldbacher #TourLife #ProductionManagement"
    hashtags: ["#TourManagement", "#LiveEvents", "#RyanGoldbacher", "#TourLife", "#ProductionManagement", "#FOHEngineer"]

  tour-announcement:
    imagePrompt: "Tour poster style graphic with dates, cities, venues for {artist}"
    captionTemplate: "🎸 {artist} tour dates announced!\n\n{dates}\n\nFull schedule: {url}\n\n#TourDates #LiveMusic #ConcertTour #RyanGoldbacher #TourManager"
    hashtags: ["#TourDates", "#LiveMusic", "#ConcertTour", "#RyanGoldbacher", "#TourManager", "#ProductionManagement"]

  podcast-promo:
    imagePrompt: "Podcast cover art style with Ryan Goldbacher and host, microphone, headphones"
    captionTemplate: "🎙️ New podcast episode!\n\n{title} with {host}\n\nListen: {url}\n\n#Podcast #TourManagement #AudioEngineering #RyanGoldbacher #LiveSound"

metrics:
  track: true
  logFile: "memory/2026-XX-XX-composio-metrics.md"
  frequency: "daily"
  metrics: ["likes", "comments", "shares", "saves", "reach", "profile_visits"]

testing:
  testMode: true
  testPostCaption: "🧪 Test post from Composio automation - Ryan Goldbacher tour management content engine"
  deleteAfterTest: true
