---
import { resumeData } from '../data/resume';
---

<header class="site-header">
  <div class="container header-inner">
    <nav class="nav" aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blog</a>
      <a href="/resume/">Resume</a>
      <a href="/tours/">Tour</a>
      <a href="/podcasts/">Podcasts</a>
      <a href="/contact/">Contact</a>
    </nav>

    <a class="brand" href="/" aria-label="Ryan Goldbacher home">
      <img class="logo-img" src="/images/ryan-goldbacher-logo.jpg" alt="Ryan Goldbacher" width="48" height="48" />
    </a>

    <div class="social-links" aria-label="Social media">
      <a class="social-icon" href={resumeData.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a class="social-icon" href={resumeData.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V9.17a8.16 8.16 0 0 0 4.78 1.52v-3.4a4.85 4.85 0 0 1-1-.6z"/></svg>
      </a>
      <a class="social-icon" href={resumeData.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43zM9.75 15.02V8.98l5.75 3.04-5.75 3z"/></svg>
      </a>
      <a class="social-icon" href={resumeData.social.linktree} target="_blank" rel="noopener noreferrer" aria-label="Linktree">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </a>
    </div>
  </div>
</header>
