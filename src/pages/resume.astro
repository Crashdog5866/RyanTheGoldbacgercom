---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resumeData } from '../data/resume';
---

<BaseLayout
  title="Resume | Ryan Goldbacher Tour Manager Production Manager FOH · Pilot"
  description="Professional resume of Ryan Goldbacher — Tour Manager, Production Manager, and FOH Audio Engineer with 20+ years of international touring experience."
  canonical="https://ryanthegoldbacher.com/resume/"
>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ryanthegoldbacher.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resume", "item": "https://ryanthegoldbacher.com/resume/" }
  ]
})} />

  <section class="section">
    <div class="container">
      <header style="margin-bottom: 2rem; text-align: center;">
        <h1>{resumeData.name}</h1>
        <p class="eyebrow" style="font-size: 1.25rem; margin: 0.5rem 0 1.5rem;">
          {resumeData.title} · Pilot
        </p>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; color: var(--muted); font-size: 0.95rem;">
          <span>{resumeData.location}</span>
          <span>•</span>
          <a href={`mailto:${resumeData.email}`} style="color: inherit;">{resumeData.email}</a>
          <span>•</span>
          <a href={`tel:${resumeData.phone}`} style="color: inherit;">{resumeData.phone}</a>
        </div>
      </header>

      <section style="margin-bottom: 3rem;">
        <h2>Professional Summary</h2>
        <p style="color: var(--muted); max-width: 800px; line-height: 1.7;">{resumeData.summary}</p>
      </section>

      <section style="margin-bottom: 3rem;">
        <h2>Specialized Skills</h2>
        <div class="grid grid-2" style="margin-top: 1.5rem;">
          <div class="card">
            <div class="card-icon" aria-hidden="true">TM/PM</div>
            <h3>Tour / Production Management</h3>
            <ul style="margin: 0; padding-left: 1.25rem; color: var(--muted); line-height: 1.8;">
              {resumeData.skills.tourManagement.map(s => <li>{s}</li>)}
            </ul>
          </div>
          <div class="card">
            <div class="card-icon" aria-hidden="true">FOH</div>
            <h3>Audio Engineering</h3>
            <ul style="margin: 0; padding-left: 1.25rem; color: var(--muted); line-height: 1.8;">
              {resumeData.skills.audioEngineering.map(s => <li>{s}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section style="margin-bottom: 3rem;">
        <h2>Touring Credits <span style="font-weight: 400; color: var(--muted); font-size: 1.25rem;">(2009–Present)</span></h2>
        <div class="grid grid-2" style="margin-top: 1.5rem; gap: 0.75rem;">
          {resumeData.credits.map(credit => (
            <article class="card" style="padding: 1.25rem;">
              <h3 style="margin: 0 0 0.5rem; font-size: 1.1rem;">{credit.artist}</h3>
              <p style="margin: 0 0 0.25rem; color: var(--accent-2); font-size: 0.9rem; font-weight: 600;">
                {credit.roles.join(' · ')}
              </p>
              <p style="margin: 0; color: var(--muted); font-size: 0.9rem;">{credit.tenure}</p>
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 3rem;">
        <h2>Professional References</h2>
        <div class="grid grid-3" style="margin-top: 1.5rem; gap: 1rem;">
          {resumeData.references.map(ref => (
            <article class="card" style="padding: 1.25rem;">
              <h3 style="margin: 0 0 0.25rem; font-size: 1rem;">{ref.name}</h3>
              <p style="margin: 0; color: var(--muted); font-size: 0.85rem;">{ref.title}</p>
            </article>
          ))}
        </div>
      </section>

      <section style="margin-bottom: 3rem;">
        <h2>Education & Affiliations</h2>
        <ul style="color: var(--muted); line-height: 2; max-width: 600px;">
          <li>{resumeData.education}</li>
          {resumeData.affiliations.map(a => <li>{a}</li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
