---
import BaseLayout from '../layouts/BaseLayout.astro';

const socials = [
  { label: 'Instagram', handle: '@RyanTheGoldbacher', url: 'https://www.instagram.com/ryanthegoldbacher/' },
  { label: 'TikTok', handle: '@RyanTheGoldbacher', url: 'https://www.tiktok.com/@RyanTheGoldbacher' },
  { label: 'YouTube', handle: '@RyanTheGoldbacher', url: 'https://www.youtube.com/@RyanTheGoldbacher' },
  { label: 'Linktree', handle: 'linktr.ee/RyanTheGoldbacher', url: 'https://linktr.ee/RyanTheGoldbacher' },
];

const services = [
  { icon: 'TM', title: 'Tour Management', text: 'Advancing, routing, budgets, travel, hospitality, and day-to-day decisions that keep the tour moving.' },
  { icon: 'PM', title: 'Production Management', text: 'Technical coordination, local crew leadership, production schedules, and vendor communication.' },
  { icon: 'FOH', title: 'FOH Audio Engineering', text: 'Front-of-house mixing, system coordination, artist-focused mixes, and calm problem-solving under pressure.' },
];

const credits = [
  ['20+ years', 'On the road across six continents'],
  ['International', 'Touring, festivals, theatres, and live events'],
  ['Artist-led', 'Production decisions built around the show'],
  ['End to end', 'Advancing through load-out'],
];

const timeline = [
  ['Tour Manager', 'Routing, advancing, budgets, hospitality, travel, and crew communication for international touring acts.'],
  ['Production Manager', 'Technical production oversight, local crew coordination, schedules, vendors, and show-day execution.'],
  ['FOH Audio Engineer', 'Live mix decisions, system tuning, artist communication, and reliable audio delivery from soundcheck to encore.'],
  ['Industry Voice', 'Sharing practical lessons from the road through short-form video, long-form interviews, and field notes.'],
];
---

<BaseLayout
  title="Ryan Goldbacher | Tour Manager, Production Manager & FOH Audio Engineer"
  description="Ryan Goldbacher is a tour manager, production manager, and FOH audio engineer with more than 20 years of international live-event experience."
  canonical="https://ryangoldbacher.com/"
>
  <main id="top">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="eyebrow">Tour Manager · Production Manager · FOH Audio Engineer</p>
          <h1>Keep the show moving. Make it sound unforgettable.</h1>
          <p class="hero-copy">Ryan Goldbacher brings more than 20 years of international road experience to every production—combining calm leadership, practical problem-solving, and a deep understanding of what artists, crews, and audiences need.</p>
          <div class="actions">
            <a class="button button-primary" href="#contact">Start a conversation <span aria-hidden="true">→</span></a>
            <a class="button" href="#experience">See the road map</a>
          </div>
        </div>
        <div class="hero-image-wrap">
          <img src="/images/ryan-goldbacher-portrait.jpg" alt="Ryan Goldbacher" loading="eager" />
        </div>
      </div>
    </section>

    <section class="section section-alt" id="work">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">What I do</p>
            <h2>One operator. Three critical roles.</h2>
          </div>
          <p>From the first advance call to the final encore, I connect the logistical, technical, and human sides of live production.</p>
        </div>
        <div class="grid grid-3">
          {services.map((service) => (
            <article class="card">
              <div class="card-icon" aria-hidden="true">{service.icon}</div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Experience</p>
            <h2>Built on the road, not in a boardroom.</h2>
          </div>
          <p>A career shaped by real-world touring, international logistics, high-pressure show days, and the people who make live music possible.</p>
        </div>
        <div class="stats">
          {credits.map(([value, label]) => (
            <div class="stat"><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
        <div class="timeline" style="margin-top: 3rem;">
          {timeline.map(([title, text]) => (
            <div class="timeline-item">
              <span class="timeline-dot" aria-hidden="true"></span>
              <div><h3>{title}</h3><p>{text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="content">
      <div class="container content-grid">
        <div>
          <p class="eyebrow">Field notes</p>
          <h2>Practical lessons from the front of house.</h2>
          <p class="hero-copy">I share the decisions, systems, and hard-won lessons that keep tours moving—without the polished mythology.</p>
          <div class="actions">
            <a class="button" href="https://www.youtube.com/@RyanTheGoldbacher" target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>
            <a class="button" href="https://www.instagram.com/ryanthegoldbacher/" target="_blank" rel="noopener noreferrer">Follow on Instagram ↗</a>
          </div>
        </div>
        <aside class="quote">
          "Take care of the people who make the show happen. Period."
          <footer>— Ryan Goldbacher</footer>
        </aside>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container contact-card">
        <p class="eyebrow">Contact</p>
        <h2>Let&#x27;s talk about the next show.</h2>
        <p>For touring, production, FOH, speaking, podcast, or media inquiries, connect through Ryan&#x27;s official social channels and Linktree.</p>
        <div class="grid grid-2" style="margin-top: 1.5rem;">
          {socials.map((social) => (
            <a class="button" href={social.url} target="_blank" rel="noopener noreferrer">{social.label} <span aria-hidden="true">↗</span><small style="display:block;color:var(--muted);font-weight:500;">{social.handle}</small></a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
