---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourDates from '../components/TourDates.astro';
import SeoHead from '../components/SeoHead.astro';
---

<BaseLayout
  title="Tour Schedule | Ryan Goldbacher Tour Manager"
  description="Current tour schedule for Texas Is The Reason, Boys Like Girls, Accept, Sebastian Bach, Brother Cane, and Tom Keifer, managed by Ryan Goldbacher."
  canonical="https://ryangoldbacher.com/tours/"
>
  <SeoHead
    title="Tour Schedule | Ryan Goldbacher Tour Manager"
    description="Current tour schedule for Texas Is The Reason, Boys Like Girls, Accept, Sebastian Bach, Brother Cane, and Tom Keifer, managed by Ryan Goldbacher."
    canonical="https://ryangoldbacher.com/tours/"
  />

  <section class="section">
    <div class="container">
      <header style="margin-bottom: 3rem; ">
        <h1>Tour Schedule</h1>
        <p class="eyebrow" style="font-size: 1.25rem; margin: 0.5rem 0 1.5rem;">Verified dates</p>
        <p style="color: var(--muted); max-width: 640px; margin-inline: auto;">
          Dates below are verified against each artist's official website. When an artist has no announced dates, their card will say so.
        </p>
      </header>
      <TourDates />
    </div>
  </section>
</BaseLayout>
